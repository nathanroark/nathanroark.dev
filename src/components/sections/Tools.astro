---
import Section from "@/components/ui/Section.astro";
import { Content } from "@/config/content.ts";
---

<Section title="Tools">
  <div class="space-y-6">
    {Content.tools.map((group) => (
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-muted-foreground">
          {group.group}
        </h3>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
          {group.tools.map((tool) => {
            const Tag = tool.link ? "a" : "div";
            return (
              <Tag
                href={tool.link}
                target={tool.link && "_blank"}
                rel={tool.link && "noopener noreferrer"}
                class:list={[
                  "flex flex-col gap-1 rounded-md border bg-card p-3",
                  tool.link && "transition-colors hover:border-accent",
                ]}
              >
                <span class="font-mono text-xs text-muted-foreground">
                  {tool.label}
                </span>
                <span class="flex items-center gap-1.5 text-sm font-semibold leading-tight">
                  {/* {tool.icon && (
                    // If you comment this out it is 1/3 the size of the rest of the page
                    <AstroIcon name={tool.icon} class="size-4 shrink-0" />
                  )} */}
                  <span class="truncate">{tool.name}</span>
                </span>
              </Tag>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</Section>

---
// import Button from "@/components/ui/Button.astro";
import Logo from "@/assets/logo.svg";
import { Content } from "@/config/content.ts";
import { Icon as AstroIcon } from "astro-icon/components";
---

<div class="space-y-1.5">
  <div class="flex items-end gap-1">
    <Logo
      aria-hidden="true"
      class="size-26 -ml-3 -mb-1.5 [&_path]:transition-transform [&_path]:duration-200 [&_path]:ease-out motion-safe:hover:[&_.logo-bowl]:translate-x-0.5 motion-safe:hover:[&_.logo-bowl]:-translate-y-0.5 motion-safe:hover:[&_.logo-leg]:translate-x-0.5 motion-safe:hover:[&_.logo-leg]:translate-y-0.5 motion-safe:hover:[&_.logo-n]:-translate-x-0.5 motion-safe:hover:[&_.logo-n]:translate-y-0.5"
    />
    <div class="space-y-1.5">
      <h1 class="text-pretty text-4xl font-bold">{Content.general.name}</h1>
      <p class="max-w-md text-pretty font-mono text-sm text-muted-foreground">
        {Content.general.about}
      </p>
      <p class="max-w-md text-pretty font-mono text-sm text-muted-foreground">
        <a
          class="inline-flex items-center gap-x-1.5 transition-colors hover:text-accent"
          href={Content.general.locationLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          <AstroIcon name="lucide:globe" class="h-4 w-auto" />
          {Content.general.location}
        </a>
      </p>
    </div>
  </div>
  <!-- <div class="flex gap-1.5 pt-1"> -->
  <!--   {Content.general.contact.social.map((social) => ( -->
  <!--     <Button href={social.url} aria-label={social.name} class="size-8"> -->
  <!--       {social.name === "GitHub" ? ( -->
  <!--         <AstroIcon name="simple-icons:github" class="h-5 w-auto" /> -->
  <!--       ) : social.name === "atproto" ? ( -->
  <!--         <AstroIcon name="simple-icons:bluesky" class="h-5 w-auto" /> -->
  <!--       ) : null} -->
  <!--     </Button> -->
  <!--   ))} -->
  <!-- </div> -->
</div>

---
import { Icon } from "astro-icon/components";
import { TechIcons } from "../config/tech-icons";

interface Props {
  name: string;
}

const { name } = Astro.props;

const iconId = TechIcons[name];
---

{
  iconId ? (
    <span class="inline-flex items-center" title={name}>
      <Icon name={iconId} class="h-5 w-auto" />
      <span class="sr-only">{name}</span>
    </span>
  ) : (
    <span class="font-mono text-[10px] text-muted-foreground">{name}</span>
  )
}

---
import TechIcon from "./TechIcon.astro";

interface Props {
  title: string;
  description: string;
  tags: readonly string[];
  link?: string;
}

const { title, description, tags, link } = Astro.props;

const Tag = link ? "a" : "div";
---

<Tag
  href={link}
  target={link ? "_blank" : undefined}
  rel={link ? "noopener noreferrer" : undefined}
  class:list={[
    "rounded-md group flex flex-col border border-border bg-card p-3 transition-all border-metal",
    link && "hover-border-sunset",
  ]}
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-base font-semibold leading-tight tracking-tight">
      {title}
    </h3>
  </div>
  <p class="mt-1.5 font-mono text-xs text-muted-foreground">
    {description}
  </p>
  <div class="mt-auto flex flex-wrap items-center gap-2.5 pt-3">
    {tags.map((tag) => <TechIcon name={tag} />)}
  </div>
</Tag>

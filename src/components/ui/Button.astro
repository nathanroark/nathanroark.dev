---
interface Props {
  class?: string;
  href?: string;
}

const { class: className = "", href } = Astro.props;

const classes =
  "inline-flex items-center justify-center rounded-xs border border-border bg-card text-card-foreground text-sm font-medium transition-colors hover-border-sunset";
---

{
  href ? (
    <a href={href} class:list={[classes, className]}>
      <slot />
    </a>
  ) : (
    <button class:list={[classes, className]}>
      <slot />
    </button>
  )
}

---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & HTMLAttributes<"button">;

const { class: className = "", href, ...rest } = Astro.props;

const classes =
  "inline-flex items-center justify-center rounded-xs border bg-card text-sm font-medium transition-colors hover:border-accent hover:text-accent";
---

{href ? (
  <a href={href} class:list={[classes, className]} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={[classes, className]} {...rest}>
    <slot />
  </button>
)}

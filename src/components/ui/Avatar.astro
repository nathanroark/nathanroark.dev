---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  fallback: string;
  class?: string;
}

const { src, alt, fallback, class: className = "" } = Astro.props;
---

<div class:list={["flex shrink-0 rounded-full border bg-card p-1", className]}>
  <div class="flex size-full overflow-hidden rounded-full">
    <Image
      src={src}
      alt={alt}
      width={240}
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover"
    />
    <div class="hidden size-full items-center justify-center bg-muted font-medium text-muted-foreground">
      {fallback}
    </div>
  </div>
</div>
